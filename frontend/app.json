{
  "expo": {
    "name": "nonprofit-mobile-app",
    "slug": "nonprofit-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nonprofitmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.example.cleanupgiveback",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.example.cleanupgiveback"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Clean Up Give Back to use your camera for photo checkpoints during cleanup sessions and your profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow Clean Up Give Back to access your photo library so you can choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.cleanupgiveback",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      "expo-task-manager",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Clean Up Give Back to use your location during cleanup sessions to show local weather and track your route.",
          "locationAlwaysAndWhenInUsePermission": "Allow Clean Up Give Back to track your cleanup route while a session is active, including when the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withNoPushEntitlement",
      "./plugins/withLocalNetworkATS",
      "./plugins/withUserScriptSandboxingDisabled",
      "./plugins/withLiveSessionWidgetPods",
      "@kingstinct/react-native-activity-kit",
      "@bacons/apple-targets",
      "./plugins/withLiveSessionWidgetAppIcon",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Clean Up Give Back to use your camera for photo checkpoints during cleanup sessions and your profile photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Clean Up Give Back to access your photo library so you can choose a profile photo.",
          "cameraPermission": "Allow Clean Up Give Back to use your camera for your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Clean Up Give Back to add volunteer events to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#009540",
          "sounds": ["./assets/sounds/photo-checkpoint-alert.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
