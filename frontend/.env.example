# Copy to .env and fill in values. Never commit .env.
# Expo exposes client-safe vars with EXPO_PUBLIC_ prefix.
# https://docs.expo.dev/guides/environment-variables/

# Supabase (sessions + volunteer auth) — Dashboard → Settings → API
# Project URL only (https://YOUR_REF.supabase.co) — do NOT append /rest/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Enable Email + Apple + Google + Facebook in Dashboard → Authentication → Providers.
# Redirect URL: nonprofitmobileapp://auth/callback (see docs/frontend/specs/volunteer-auth.md)

# Fly sessions API (set after deploy)
EXPO_PUBLIC_API_URL=https://sessions.example.com

# CARTO basemap API key (free) — required for raster map tiles (Recent Cleanups, event pins).
# Without it, CARTO overlays a "KEY REQUIRED" watermark on raster tiles.
# https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_BASEMAP_API_KEY=

# Same CARTO key for admin console maps: add to admin-web-app/.env.local as
# NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=<same value>

# Optional: shorten free-hour trial for QA (seconds; default 3600)
# EXPO_PUBLIC_FREE_TRIAL_SECONDS=120
# Dev only — skip pre-track paywall after orientation hour is consumed:
# EXPO_PUBLIC_BYPASS_SECOND_TRACK_PAYWALL=1

# Stripe publishable key (optional for hosted Checkout; documented for future PaymentSheet)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# See features/session-tracking/services/weather.ts
