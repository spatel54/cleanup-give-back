# Copy to .env.local — never commit .env.local
# Same Supabase project as `frontend/` (mobile) and `admin/` — admin-web-app reads
# and writes the same tables (sessions, volunteer_feedback, shop_orders,
# events, court_orders), so live data here is live everywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set true for local UI work without Supabase Auth wired up yet (skips the
# admin-role check in server actions; pages still fall back to mock data
# automatically when a table is empty).
BYPASS_AUTH=true

# Optional — session approve/decline + event at-risk-volunteer emails soft-fail
# (log + skip) when unset, same as `admin/.env.local`.
# Put these in `.env.local` (preferred) or `.env` — never commit either file.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.org
# Used by Fly session-finalize alerts; harmless in admin-web-app if unused.
ADMIN_NOTIFY_EMAIL=
# Vercel cron → GET /api/cron/send-scheduled-emails (Authorization: Bearer …).
CRON_SECRET=

# Optional — powers Generate Letterhead (single + bulk PDF) in the session
# preview drawer, and Shippo Buy label on order detail, proxied to
# `backend/sessions`. Without these, those buttons show a not-configured error.
SESSIONS_API_URL=
ADMIN_API_KEY=

# Optional — when set, the event address field uses Google Places Autocomplete.
# Without it, addresses verify via the free US Census geocoder on blur; create/update
# still geocodes on save (Census first, Google Geocoding if this key is present).
# You can also set server-only GOOGLE_MAPS_API_KEY for Geocoding without exposing Places.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# CARTO basemap API key (free) — required for session walking-path and event location
# raster maps; without it CARTO overlays a "KEY REQUIRED" watermark.
# Same key as mobile `EXPO_PUBLIC_CARTO_BASEMAP_API_KEY` in frontend/.env
# https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=
